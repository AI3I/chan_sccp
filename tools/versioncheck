#!/bin/sh
# Sourced from configure in the source directory. .version is authoritative.
SCCP_VERSION=$(cat .version)
case "$SCCP_VERSION" in
  ''|*[!0-9.]*) echo 'Invalid .version: expected a numeric release version' >&2; return 1 2>/dev/null || exit 1;;
esac
SCCP_BRANCH=archive
SCCP_REVISION=unknown
REPOS_TYPE=TGZ
if test -e .git && command -v git >/dev/null 2>&1; then
  SCCP_BRANCH=$(git symbolic-ref --short -q HEAD || echo detached)
  SCCP_REVISION=$(git rev-parse --short HEAD)
  REPOS_TYPE=GIT
fi
if test "${1:-}" != silent; then
  printf 'SCCP_VERSION: %s\nSCCP_BRANCH: %s\nSCCP_REVISION: %s\nREPOS_TYPE: %s\n' \
    "$SCCP_VERSION" "$SCCP_BRANCH" "$SCCP_REVISION" "$REPOS_TYPE"
fi
